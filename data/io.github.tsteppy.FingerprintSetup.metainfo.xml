<component type="desktop-application">
  <id>io.github.tsteppy.FingerprintSetup</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Fingerprint Setup</name>
  <summary>Enrol fingerprints that actually work</summary>

  <description>
    <p>
      Laptop fingerprint readers see a small patch of your finger, so a press
      only matches if it lands where you enrolled. Enrolling every press the
      same way is the usual reason fingerprint login feels unreliable.
    </p>
    <p>
      Fingerprint Setup guides each enrolment press to a different part of your
      fingertip, then tests the result and tells you whether it is any good
      before you rely on it.
    </p>
    <p>Works with any reader supported by fprintd.</p>
  </description>

  <developer id="io.github.tsteppy">
    <name>Thaddeus Stepanovich</name>
  </developer>

  <screenshots>
    <screenshot type="default">
      <caption>Enrolled fingers, with a test for each and the fingerprint login status</caption>
      <image>https://raw.githubusercontent.com/tsteppy/fingerprintsetup/main/data/screenshots/main-window.png</image>
    </screenshot>
  </screenshots>

